# Name of the PostgreSQL database the API uses (spring.datasource.url)
DB_NAME=orderflow
# PostgreSQL user the API connects as (spring.datasource.username)
DB_USER=orderflow
# Password of that user (spring.datasource.password): set a real value only in your local .env
DB_PASSWORD=change-me
# HTTP port of the API (server.port), inside the container and on the host
API_PORT=8080
# Language of the error messages when Accept-Language is missing or unsupported (app.i18n.default-locale)
API_DEFAULT_LOCALE=es
# Outbox relay: wait between two polls for due events (app.outbox.poll-interval)
API_OUTBOX_POLL_INTERVAL=1s
# Outbox relay: how long a claimed event stays leased before another poll may send it again (app.outbox.lease)
API_OUTBOX_LEASE=30s
# Outbox relay: delivery attempts before an event becomes DEAD (app.outbox.max-attempts)
API_OUTBOX_MAX_ATTEMPTS=8
# Outbox relay: first retry wait, doubled per failed attempt (app.outbox.backoff.base)
API_OUTBOX_BACKOFF_BASE=2s
# Outbox relay: longest retry wait (app.outbox.backoff.max)
API_OUTBOX_BACKOFF_MAX=5m
# Housekeeping: how long idempotency keys are kept (app.idempotency.retention)
API_IDEMPOTENCY_RETENTION=24h
# Housekeeping: how long expired quotes and SENT events are kept (app.housekeeping.retention)
API_HOUSEKEEPING_RETENTION=7d
